# Yerel derleme (calisma kopyasindan): bu klasorde `makepkg -si`
# AUR paketi: aur/PKGBUILD
pkgname=legion-fan-control
pkgver=2.7.1
pkgrel=5
pkgdesc="Extreme Cooling, automatic fan mode and gaming tools for Lenovo Legion Y520-15IKBN"
arch=('any')
url="https://github.com/fatih5228/LegionFanControl"
license=('MIT')
depends=('python' 'pyside6' 'python-dbus' 'python-gobject' 'glib2' 'acpi_call' 'dmidecode' 'pciutils')
optdepends=('nvidia-utils: GPU sicakligi (nvidia-smi)')
install=legion-fan-control.install

package() {
  cd "$startdir"
  make DESTDIR="$pkgdir" install
  install -Dm644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
